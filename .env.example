# --- Base de datos ---
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# --- Puertos publicados en tu máquina (docker-compose.yml) ---
BACKEND_PORT=8080
FRONTEND_PORT=80

# --- Seguridad y CORS (variables leídas por la aplicación) ---
# JWT_SECRET=cambia_esta_clave_base64_de_al_menos_32_bytes
# JWT_EXPIRATION_MS=3600000
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://andres-albornoz.github.io

# --- Solo para producción (docker-compose.prod.yml) ---
DOCKERHUB_USER=tu_usuario
IMAGE_TAG=1.0